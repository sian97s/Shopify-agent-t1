# Everything below is optional. Art Universe runs fully offline with defaults.
PORT=8788
DATA_DIR=./data
# Set to enable Claude-powered semantic analysis, safety screening, OCR and title suggestions.
# Without it the local deterministic AI providers are used (no network required).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Upload-session lifetime knobs (milliseconds)
UPLOAD_SESSION_TTL_MS=600000
UPLOAD_SESSION_GRACE_MS=90000
# Admin token for the moderation review queue (/api/admin/*). Generated if unset.
ADMIN_TOKEN=
